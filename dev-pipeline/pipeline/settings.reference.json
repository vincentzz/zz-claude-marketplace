{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/pipeline/statusline-budget.sh"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git worktree*)",
      "Bash(git branch*)",
      "Bash(git -C *)",
      "Bash(mvn *)",
      "Bash(bash tasks/specs/*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}